# Gemini API Key (Required ONLY for the AI Disaster Assistant chat feature; map & dashboard work without it)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Backend internal URL for Next.js /api proxy (defaults to http://127.0.0.1:8000)
# BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# ==============================================================================
# Public Deployment Security & Cost-Protection Settings
# ==============================================================================
# Comma-separated allowed CORS origins (never defaults to '*').
# CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set to 'false' on public hosting to require visitors to enter their own Gemini API Key (BYOK).
# AI_PUBLIC_SERVER_KEY_ENABLED=true

# Optional shared access code required when using the server's GEMINI_API_KEY (X-Ai-Access-Code).
# AI_ACCESS_CODE=

# Keep 'false' in public deployments to block expensive frontier models on the shared server key.
# AI_ALLOW_PREMIUM_MODELS=false

# Rate limits & hard daily request cap for server-key AI calls:
# AI_RATE_LIMIT_PER_MIN=8
# AI_RATE_LIMIT_PER_HOUR=40
# AI_DAILY_BUDGET_REQUESTS=300
# AI_MAX_CONCURRENT_PER_IP=2
# AI_MAX_CONCURRENT_GLOBAL=15
# AI_MAX_MESSAGE_CHARS=1200
# AI_MAX_OUTPUT_TOKENS=1536
# AI_TRUST_PROXY_HEADERS=false
